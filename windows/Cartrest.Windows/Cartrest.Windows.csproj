<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Cartrest</AssemblyName>
    <StartupObject>Cartrest.Windows.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../installer/Cartrest.ico</ApplicationIcon>
    <UseRidGraph>false</UseRidGraph>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <Content>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ProjectReference Include="../Cartrest.Core/Cartrest.Core.csproj" />
    <Resource Include="../installer/Cartrest.ico" Link="Resources/Cartrest.ico" />
    <Resource Include="../../design/icon/Cartrest-Liquid-Glass.png" Link="Resources/Cartrest-Mark.png" />

    <Content Include="../../consoles/*.json" Link="Resources/Consoles/%(Filename)%(Extension)" />
    <Content Include="../../design/labels/catalog.json" Link="Resources/Labels/catalog.json" />
    <Content Include="../../design/labels/assets/*.png" Link="Resources/Labels/assets/%(Filename)%(Extension)" />
    <Content Include="../../design/labels/fonts/*" Link="Resources/Labels/fonts/%(Filename)%(Extension)" />
    <Content Include="../../examples/cartridge-labels/*.png" Link="Resources/Samples/ds/%(Filename)%(Extension)" />
    <Content Include="../../examples/3ds/*.png" Link="Resources/Samples/3ds/%(Filename)%(Extension)" />
    <Content Include="../../examples/switch/*.png" Link="Resources/Samples/switch/%(Filename)%(Extension)" />
    <Content Include="../../examples/switch2/*.png" Link="Resources/Samples/switch2/%(Filename)%(Extension)" />
    <Content Include="../../examples/reconstructions/kirby-super-star-ultra/background.png" Link="Resources/Kirby/background.png" />
    <Content Include="../../LICENSE" Link="LICENSE" />
    <Content Include="../../design/labels/README.md" Link="Resources/Labels/ASSETS.md" />
    <Content Include="../../examples/README.md" Link="Resources/Samples/SOURCES.md" />
  </ItemGroup>
</Project>
